NODE_ENV=development
PORT=3000

# MongoDB connection URI
# Local dev:  mongodb://127.0.0.1:27017/whereisthebin
# Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/whereisthebin
MONGODB_URI=mongodb://127.0.0.1:27017/whereisthebin

# Required in production — use a long random string (32+ chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# Nominatim usage policy requires a real contact email
NOMINATIM_USER_AGENT=WhereIsTheBin/0.1 (contact: you@example.com)

# Contact email shown on About/Privacy pages
CONTACT_EMAIL=you@example.com

# Set to 1 to enable the Service Worker in development (off by default)
ENABLE_SW=