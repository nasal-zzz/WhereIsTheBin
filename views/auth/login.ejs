<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="section">
  <div class="wrap narrow">
    <h1 class="h-page"><%= t('auth.login.title') %></h1>
    <%- include('../partials/messages') %>
    <form method="post" action="/login" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <div class="field"><label for="email"><%= t('auth.email') %></label>
        <input id="email" name="email" type="email" maxlength="254" autocomplete="email" required value="<%= values.email || '' %>"></div>
      <div class="field"><label for="password"><%= t('auth.password') %></label>
        <input id="password" name="password" type="password" maxlength="128" autocomplete="current-password" required></div>
      <button class="btn btn-primary" type="submit"><%= t('auth.login.submit') %></button>
    </form>
    <p class="switch"><a href="/register"><%= t('auth.switch.toRegister') %></a></p>
  </div>
</main>
<%- include('../partials/footer') %>
